# Ejemplo de configuración de DonaVida
# Copia este archivo como .env y escribe la contraseña real en DB_PASSWORD

# Puerto donde escucha el servidor de Express
PORT=3000

# Conexión a MySQL con el usuario de la aplicación (solo SELECT e INSERT)
DB_HOST=localhost
DB_PORT=3306
DB_USER=donavida_app
DB_PASSWORD=escribe_aqui_la_contrasena
DB_NAME=donavida
